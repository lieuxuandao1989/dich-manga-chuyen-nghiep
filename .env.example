# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Optional comma-separated list of multiple Gemini API keys for automatic rotation (up to 10 keys).
# Example: "AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3..."
GEMINI_API_KEYS=

# You can also define individual keys: GEMINI_API_KEY_1 to GEMINI_API_KEY_10
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# SHOPAIKEY_API_KEY: Optional ShopAIKey API key (sk-...) routed via https://api.shopaikey.com
SHOPAIKEY_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
